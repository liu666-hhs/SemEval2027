def make_prompt(q):
    return (
        "Look at the image and answer the question in 1–2 concise sentences. "
        "Do not deviate from the question, and do not guess, speculate, or fabricate."
        f"\n\nQuestion: {q}"
    )

def load_image_column(example):
    prompt = [
        {
            "role": "user",
            "content": [
                {"type": "image"},  # Placeholder for the image
                {"type": "text", "text":make_prompt(example["question"])},  # The text part of the prompt
            ],
        },
    ]
    an=example["answer"]
    ll = os.path.join(IMAGE_ROOT, example["image"])
    ll=load_image(ll)
    return {"prompt":prompt,"image":ll,"answer":an}
