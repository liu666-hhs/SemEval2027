from concurrent.futures import ThreadPoolExecutor
import os
import torch
from PIL import Image
from unsloth import FastModel, FastVisionModel, UnslothVisionDataCollator
from trl import SFTConfig, SFTTrainer
from datasets import Dataset,  Sequence, load_dataset
from datasets import Dataset, Sequence, load_dataset, Image as HFImage
from bert_score import score
max_seq_length = 768
MAX_SIDE = 512 
w = load_dataset("parquet", data_files=r"D:\liu\Desktop\多模态文化图片+文字\dataset\train_en.parquet",split="train")
IMAGE_ROOT = r"D:\liu\Desktop\多模态文化图片+文字\dataset\images_mena_train"
N = 500

def load_image(path):
    with Image.open(path) as im:
        im = im.convert("RGB")
        if max(im.size) > MAX_SIDE:
            im.thumbnail((MAX_SIDE, MAX_SIDE), Image.LANCZOS)  # 原地缩放
        return im

def build_one(i):
    ll = os.path.join(IMAGE_ROOT, w[i]["image"])
    return {
        "messages": [
            {"role": "user", "content": [
                {"type": "image", "image": load_image(ll)},
                {"type": "text", "text": w[i]["question"]},
            ]},
            {"role": "assistant", "content": [
                {"type": "text", "text": w[i]["answer"]},
            ]},
        ]
    }

with ThreadPoolExecutor(max_workers=8) as ex:
    dataset_list = list(ex.map(build_one, range(N)))

dataset = Dataset.from_list(dataset_list)
print("ddddddddddddd")
model, tokenizer = FastModel.from_pretrained(
    model_name = r"D:\huggingface\QwenQwen3.5-4B",
    max_seq_length = 768,
    load_in_4bit = True,   # MoE QLoRA not recommended, dense 27B is fine
    load_in_16bit = False,     # bf16/16-bit LoRA
    full_finetuning = False,
    device_map = "cuda",
)
model = FastVisionModel.get_peft_model(
    model,
    finetune_vision_layers     = True, # False if not finetuning vision layers
    finetune_language_layers   = True, # False if not finetuning language layers
    finetune_attention_modules = True, # False if not finetuning attention layers
    finetune_mlp_modules       = True, # False if not finetuning MLP layers
    r = 16,                           # The larger, the higher the accuracy, but might overfit
    lora_alpha = 16,                  # Recommended alpha == r at least
    lora_dropout = 0,
    bias = "none",
    random_state = 3407,
    use_rslora = False,               # We support rank stabilized LoRA
    loftq_config = None,               # And LoftQ
    target_modules = "all-linear",    # Optional now! Can specify a list if needed
)
FastVisionModel.for_training(model) # Enable for training!

trainer = SFTTrainer(
    model = model,
    tokenizer = tokenizer,
    data_collator = UnslothVisionDataCollator(model, tokenizer), # Must use!
    train_dataset = dataset,
    args = SFTConfig(
        per_device_train_batch_size = 2,
        gradient_accumulation_steps = 4,
        warmup_steps = 5,
        num_train_epochs = 3,
        # num_train_epochs = 1, # Set this instead of max_steps for full training runs
        learning_rate = 2e-4,
        logging_steps = 1,
        optim = "adamw_8bit",
        weight_decay = 0.001,
        lr_scheduler_type = "linear",
        seed = 3407,
        output_dir = "outputs",
        report_to = "none",     # For Weights and Biases

        # You MUST put the below items for vision finetuning:
        remove_unused_columns = False,
        dataset_text_field = "",
        dataset_kwargs = {"skip_prepare_dataset": True},
        max_length = 768,
    ),
)
trainer.train()

# 1. 切推理模式
model.eval()
model.get_base_model().gradient_checkpointing_disable()
model.config.use_cache = True
if hasattr(model, "base_model"):
    model.base_model.model.config.use_cache = True

w1 = load_dataset(
    "parquet",
    data_files=r"D:\liu\Desktop\多模态文化图片+文字\dataset\dev_en.parquet",
    split="train",
)
image_root = r"D:\liu\Desktop\多模态文化图片+文字\dataset\images_mena_dev"

predictions, references, records = [], [], []
print("=============================")
print(len(w1))
N = min(50, len(w1))
pad_token_id = tokenizer.tokenizer.pad_token_id or tokenizer.tokenizer.eos_token_id
BATCH_SIZE = 4  
for start in range(0, N, BATCH_SIZE):
    end = min(start + BATCH_SIZE, N)
    batch_rows = [w1[i] for i in range(start, end)]

    images, texts = [], []
    for row in batch_rows:
        image_path = os.path.join(image_root, row["image"])
        images.append(load_image(image_path))
        texts.append(
            tokenizer.apply_chat_template(
                [{"role": "user", "content": [
                    {"type": "image"},
                    {"type": "text", "text": row["question"]},
                ]}],
                add_generation_prompt=True,
            )
        )

    inputs = tokenizer(
        images, texts,
        add_special_tokens=False,
        return_tensors="pt",
        padding=True,                  # 批量必须 padding
    ).to("cuda")

    with torch.inference_mode():
        with torch.autocast("cuda", dtype=torch.bfloat16):
            generated_ids = model.generate(
                **inputs,
                max_new_tokens=128,
                use_cache=True,
                do_sample=False,
                pad_token_id=pad_token_id,
            )

    gen_trimmed = generated_ids[:, inputs["input_ids"].shape[1]:]
    answers = tokenizer.batch_decode(
        gen_trimmed,
        skip_special_tokens=True,
        clean_up_tokenization_spaces=False,
    )

    for row, ans in zip(batch_rows, answers):
        ans = ans.strip()
        predictions.append(ans)
        references.append(str(row["answer"]).strip())
        records.append({
            "image": row["image"],
            "question": row["question"],
            "prediction": ans,
            "reference": row["answer"],
        })
    del inputs, generated_ids, gen_trimmed
    torch.cuda.empty_cache()       

print("预测答案数量:", len(predictions))
print("标准答案数量:", len(references))

P, R, F1 = score(
    predictions,
    references,
    lang="en",
    model_type="roberta-large",
    device="cpu",
    batch_size=8,
)
print("BERTScore F1:", F1.mean().item())
