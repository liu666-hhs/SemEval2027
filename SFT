dataset = dataset.shuffle(seed=42)
model, tokenizer = FastVisionModel.from_pretrained(
    model_name = r"/hy-tmp/models/Qwen3.5-9B",
    max_seq_length = max_seq_length,
    load_in_4bit = True,   # MoE QLoRA not recommended, dense 27B is fine
    load_in_16bit = False,     # bf16/16-bit LoRA
    full_finetuning = False,
    device_map = "cuda",
)
model = FastVisionModel.get_peft_model(
    model,
    finetune_vision_layers     = True, # False if not finetuning vision layers
    finetune_language_layers   = True, # False if not finetuning language layers
    finetune_attention_modules = True, # False if not finetuning attention layers
    finetune_mlp_modules       = True, # False if not finetuning MLP layers
    r =32,       
                        # The larger, the higher the accuracy, but might overfit
    lora_alpha = 64,                  # Recommended alpha == r at least
    lora_dropout = 0.05,
    bias = "none",
    use_gradient_checkpointing = "unsloth", 
    random_state = 3407,
    use_rslora = False,               # We support rank stabilized LoRA
    loftq_config = None,               # And LoftQ   # Optional now! Can specify a list if needed
)
FastVisionModel.for_training(model) # Enable for training!

# 修改后（告诉它只计算 assistant 答案部分的 Loss）
trainer = SFTTrainer(
    model = model,
    tokenizer = tokenizer,
    data_collator =UnslothVisionDataCollator(model, tokenizer,  resize="max",train_on_responses_only=True,formatting_func=prepare_example,instruction_part="<|im_start|>user\n", response_part="<|im_start|>assistant\n<think>\n\n</think>\n\n"), # Must use!
    train_dataset = dataset,
    args = SFTConfig(
        per_device_train_batch_size = 2,
        gradient_accumulation_steps = 16,
        warmup_ratio = 0.1,
        num_train_epochs = 1,
        # num_train_epochs = 2, # Set this instead of max_steps for full training runs
        learning_rate = 2e-4,
        logging_steps = 1,
        optim = "adamw_8bit",
        weight_decay = 0.003,
        lr_scheduler_type = "linear",
        seed = 3407,
        output_dir = "/hy-tmp/ll/outputs",
        report_to = "none",     # For Weights and Biases
        bf16=True,
        remove_unused_columns = False,
        dataset_text_field = "",
        dataset_kwargs = {"skip_prepare_dataset": True},
        max_length = max_seq_length,
    ),
)
trainer.train()
model.save_pretrained(r"/hy-tmp/ll/qwen3_5_lora199_model")
tokenizer.save_pretrained(r"/hy-tmp/ll/qwen3_5_lora199_model")
