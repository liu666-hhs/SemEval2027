_original_sent_encode = bert_score_utils.sent_encode


def _sent_encode_compat(tokenizer, sent):
    # Transformers 5 的 RoBERTa 分词器不再提供旧的空文本编码接口。
    if not sent.strip() and not hasattr(tokenizer, "build_inputs_with_special_tokens"):
        return tokenizer.encode("", add_special_tokens=True)
    return _original_sent_encode(tokenizer, sent)
def prepare_example(example):
    for message in example["messages"]:
        for item in message["content"]:
            if item.get("type") == "image":
                item["image"] = load_image(item["image"])
    return example

bert_score_utils.sent_encode = _sent_encode_compat

max_seq_length = 1700   # MAX_SIDE=800 下实测最长样本 761 token，余量 ~26%
MAX_SIDE=1200
w = load_dataset("parquet", data_files=r"/hy-tmp/ll/train_en.parquet",split="train")
IMAGE_ROOT = r"/hy-tmp/ll/images_mena_train"

def make_prompt(q):
    return (
        "Look at the image and answer the question in 1–2 sentences."
        "Do not deviate from the question, and do not fabricate."
        f"\n\nQuestion: {q}"
    )
def load_image(path):
    with Image.open(path) as im:
        im = im.convert("RGB")
        if max(im.size) > MAX_SIDE:
            im.thumbnail((MAX_SIDE, MAX_SIDE), Image.LANCZOS)  # 原地缩放
        return im
def load_image_column(example):
    ll = os.path.join(IMAGE_ROOT, example["image"])
    return {
            "messages": [
                {"role": "user", "content": [
                    {"type": "image", "image":ll},
                    {"type": "text", "text":make_prompt(example['question'])},
                ]},
                {"role": "assistant", "content": [
                    {"type": "text", "text":example["answer"]},
                ]},
            ]
        }
